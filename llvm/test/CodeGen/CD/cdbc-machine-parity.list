# Artifact mode compares the cdbc text after canonicalizing only table and
# virtual-register indices. Behavior mode still requires dump and run parity,
# while allowing a documented machine-specific lowering shape.
artifact llvm/test/CodeGen/CD/cdbc-machine.ll
artifact llvm/test/CodeGen/CD/cdbc-machine-call.ll
artifact llvm/test/CodeGen/CD/cdbc-machine-cast.ll
artifact llvm/test/CodeGen/CD/cdbc-machine-nil-return.ll
artifact llvm/test/CodeGen/CD/cdbc-machine-parameters.ll
artifact llvm/test/CodeGen/CD/cdbc-machine-storage.ll
artifact llvm/test/CodeGen/CD/cdbc-machine-unary.ll
artifact llvm/test/CodeGen/CD/cdbc-machine-void-call.ll
artifact llvm/test/CodeGen/CD/cdbc-machine-void-return.ll
artifact llvm/test/CodeGen/CD/cdbc-string.ll
artifact llvm/test/CodeGen/CD/cdbc-array.ll
artifact llvm/test/CodeGen/CD/cdbc-array-access.ll
artifact llvm/test/CodeGen/CD/cdbc-struct.ll
behavior llvm/test/CodeGen/CD/cdbc-struct-dynamic.ll
behavior llvm/test/CodeGen/CD/cdbc-map.ll
runtime-error llvm/test/CodeGen/CD/cdbc-map-runtime.ll "map key not found"
runtime-error llvm/test/CodeGen/CD/cdbc-struct-runtime.ll "undefined field `missing`"
behavior llvm/test/CodeGen/CD/cdbc-array-assign.ll
behavior llvm/test/CodeGen/CD/cdbc-array-assign-scalar.ll
runtime-error llvm/test/CodeGen/CD/cdbc-array-access-runtime.ll "for-in expects array, range, or map"
runtime-error llvm/test/CodeGen/CD/cdbc-array-assign-runtime.ll "array index out of range"
behavior llvm/test/CodeGen/CD/cdbc-machine-arithmetic.ll
behavior llvm/test/CodeGen/CD/cdbc-machine-compare.ll
behavior llvm/test/CodeGen/CD/cdbc-machine-control-flow.ll
behavior llvm/test/CodeGen/CD/cdbc-machine-not.ll
behavior llvm/test/CodeGen/CD/cdbc-machine-select.ll
artifact llvm/test/CodeGen/CD/cdbc-variant.ll
behavior llvm/test/CodeGen/CD/cdbc-variant-dynamic.ll
runtime-error llvm/test/CodeGen/CD/cdbc-variant-runtime.ll "enum variant field index out of bounds"
runtime-error llvm/test/CodeGen/CD/cdbc-variant-runtime-nonvariant.ll "can only access fields on enum variants"
artifact llvm/test/CodeGen/CD/cdbc-native.ll
artifact llvm/test/CodeGen/CD/cdbc-native-values.ll
runtime-error llvm/test/CodeGen/CD/cdbc-native-runtime.ll "sqrt expects non-negative number"
artifact llvm/test/CodeGen/CD/cdbc-debug-sources.ll
# The range fixture uses fdiv; direct and machine constant materialization
# order differs, so FileCheck asserts identical ranges and parity checks VM
# behavior rather than applying the index-only artifact projection.
behavior llvm/test/CodeGen/CD/cdbc-debug-ranges.ll
observability llvm/test/CodeGen/CD/cdbc-debug-ranges.ll "break-range ranges.cd:6-11;continue;quit" ranges
observability llvm/test/CodeGen/CD/cdbc-machine.ll "continue" metadata-free
observability llvm/test/CodeGen/CD/cdbc-debug-ranges.ll "break-range ranges.cd:6-11;step;next;quit" step-next
observability llvm/test/CodeGen/CD/cdbc-debug-ranges.ll "break-range ranges.cd:6-11;s;n;q" aliases
observability llvm/test/CodeGen/CD/cdbc-debug-ranges.ll "break ranges.cd:1;continue;delete 1;continue" line-delete
# The location fixture has identical debug tables, while direct and machine
# constant scheduling gives the main add different operand/register order.
behavior llvm/test/CodeGen/CD/cdbc-debug-locations.ll
runtime-error llvm/test/CodeGen/CD/cdbc-debug-runtime.ll "Runtime error at runtime.cd:1:22: division by zero"
debug-error llvm/test/CodeGen/CD/cdbc-debug-runtime.ll "continue;quit" "pause reason=error function=fail instruction=2 module=none location=runtime.cd:1:22 stack=main@runtime.cd:2:1>fail@runtime.cd:1:22"
runtime-error llvm/test/CodeGen/CD/cdbc-debug-native-runtime.ll "Runtime error at native.cd:1:1: sqrt expects non-negative number"
runtime-error llvm/test/CodeGen/CD/cdbc-debug-index-runtime.ll "Runtime error at index.cd:1:14: array index out of range"
